+def _resseq(res):
+    """Sort key for a residue id: its number, then any insertion code ("100A")."""
+    digits = "".join(ch for ch in res.id if ch.isdigit() or ch == "-")
+    try:
+        return (int(digits), res.id)
+    except ValueError:
+        return (0, res.id)
+
+
+def _fill_gaps(selected, max_gap):
+    """Add the protein residues in gaps of up to ``max_gap`` between selected ones.
+
+    Capping both sides of a short gap puts the NME cap of one residue and the ACE
+    cap of the next into the space of the missing residue(s), with overlapping
+    atoms (0.6-0.9 A apart for a one-residue gap); the real residues are used
+    instead, as in QM cluster models.
+    """
+    if max_gap <= 0 or not selected:
+        return selected
+    chosen = {id(r) for r in selected}
+    extra = []
+    by_chain = {}
+    for res in selected:
+        by_chain.setdefault(res.chain, []).append(res)
+    for chain, residues in by_chain.items():
+        numbered = {}
+        for res in chain.residues():
+            if res.name in PROTEIN_RES and res.id.lstrip("-").isdigit():
+                numbered[int(res.id)] = res
+        numbers = sorted(int(r.id) for r in residues if r.id.lstrip("-").isdigit())
+        for a, b in zip(numbers, numbers[1:]):
+            between = range(a + 1, b)
+            if 0 < len(between) <= max_gap and all(n in numbered for n in between):
+                extra += [numbered[n] for n in between if id(numbered[n]) not in chosen]
+    return selected + extra
+
+
