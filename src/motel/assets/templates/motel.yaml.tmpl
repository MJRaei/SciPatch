# Motel tool package manifest.
# Field reference: docs/tool-format.md in the Motel repository.
schema: 1
name: $name
version: 0.1.0
title: $title
summary: >-
  TODO: one or two sentences saying what this tool computes and for which systems.
domains: []            # e.g. [materials, chemistry]
tags: []               # search keywords, e.g. [relaxation, ml-potential, dft]

source:
  repo: $repo
  ref: $ref           # pinned commit or tag, so rebuilds are exact
  install: $install_source       # pip-install the repository into the environment
  paper: $paper
  citation: null
  license: null

environment:
  manager: uv          # 'conda' when conda-forge packages are needed
  python: "$python"
  packages: []         # extra PyPI requirements, e.g. ["numpy<2", "torch>=2.2"]

entrypoint: api        # the module whose public functions are exposed

# Optional per-function settings:
# functions:
#   relax:
#     long_running: false
#     params:
#       structure: {kind: structure}
#     outputs:
#       energy_ev_per_atom: {unit: eV/atom}

validity: >-
  TODO: when can results be trusted? Training data, supported elements or
  chemistries, level of theory, and known failure modes.

# Golden tests reproduce known numbers (ideally from the paper).
golden: []
